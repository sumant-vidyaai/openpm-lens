{
  "name": "spashta",
  "version": "1.3.5",
  "private": true,
  "description": "Open-source, tool-agnostic project management analytics: standard metrics, health scores and dashboards that run in the browser.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "dev": "npm run dev -w @spashta/web",
    "build": "npm run build -w @spashta/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
